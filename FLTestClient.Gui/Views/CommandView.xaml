<UserControl x:Class="FLTestClient.Gui.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:FLTestClient.Gui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Cmd.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Cmd.Subtitle}" Style="{StaticResource Muted}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Connection to the FLHook admin socket -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cmd.Connection}" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Cmd.Host}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AdminHost}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Cmd.Port}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AdminPort}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Cmd.Password}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox gui:Behaviors.BoundPassword="{Binding AdminPassword}" />
                            <Button Grid.Column="1" Content="{DynamicResource Cmd.FromIni}" Command="{Binding LoadAdminPasswordCommand}" Margin="8,0,0,0"
                                    ToolTip="{DynamicResource Cmd.FromIniTip}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Commands -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cmd.Commands}" Style="{StaticResource CardTitle}" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="{DynamicResource Cmd.PlayerList}" Command="{Binding AdminGetPlayersCommand}" Margin="0,0,8,6" />
                            <Button Content="{DynamicResource Cmd.Rehash}" Command="{Binding AdminRehashCommand}" Margin="0,0,8,6"
                                    ToolTip="{DynamicResource Cmd.RehashTip}" />
                            <Button Style="{StaticResource DangerButton}" Content="{DynamicResource Cmd.KickSelected}" Command="{Binding AdminKickSelectedCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AdminCommand, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Cmd.CommandTip}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AdminRunCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="{DynamicResource Cmd.Run}" Command="{Binding AdminRunCommand}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Distribute bots across systems -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cmd.Distribute}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{DynamicResource Cmd.DistributeHint}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding DistributeBases}" AcceptsReturn="True" Height="170" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding DistributeAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Cmd.DistributeAll}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{DynamicResource Cmd.DistributeSelected}" Command="{Binding DistributeSelectedCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Console output -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Cmd.Console}" Style="{StaticResource CardTitle}" />
                <ListBox ItemsSource="{Binding AdminOutput}" Style="{StaticResource FeedList}" ItemTemplate="{StaticResource FeedTemplate}"
                         gui:Behaviors.AutoScroll="True" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
