<Window x:Class="FLTestClient.Gui.Views.FleetActionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="760" Height="680" MinWidth="640" MinHeight="540" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock x:Name="Heading" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{DynamicResource Action.Explanation}" Style="{StaticResource Muted}"/>
   <TextBlock x:Name="Endpoint" Margin="0,10,0,0" TextWrapping="Wrap"/>
   <TextBlock x:Name="LaunchHint" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock Text="{DynamicResource Fleet.DockTarget}" Style="{StaticResource FieldLabel}"/>
   <ComboBox x:Name="SingleBase" IsEditable="True" IsTextSearchEnabled="True" />
   <TextBox x:Name="TargetBases" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" TextChanged="TargetsChanged" FontFamily="{StaticResource MonoFont}"/>
   <TextBlock Text="{DynamicResource Action.TargetHint}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
  </StackPanel>
  <DockPanel Grid.Row="2">
   <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>
   <DataGrid x:Name="Preview"><DataGrid.Columns>
    <DataGridTextColumn Binding="{Binding Name}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Pilot}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Base}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Fleet.DockTarget}"/></DataGridTextColumn.Header></DataGridTextColumn>
   </DataGrid.Columns></DataGrid>
  </DockPanel>
  <DockPanel Grid.Row="3" Margin="0,16,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{DynamicResource Common.Cancel}" IsCancel="True"/>
    <Button x:Name="Execute" Content="{DynamicResource Action.Execute}" Style="{StaticResource AccentButton}" Click="ExecutePlan" Margin="0"/>
   </StackPanel>
   <Button Content="{DynamicResource Action.Refresh}" Click="RefreshPreview" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</Window>
