<UserControl x:Class="FLTestClient.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:FLTestClient.Gui">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Set.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Set.Subtitle}" Style="{StaticResource Muted}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Set.Section}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="SectionPicker" SelectedIndex="0" Width="280" HorizontalAlignment="Left">
                <ComboBoxItem Content="{DynamicResource Set.SectionServer}" />
                <ComboBoxItem Content="{DynamicResource Set.SectionIdentity}" />
                <ComboBoxItem Content="{DynamicResource Set.SectionCharacters}" />
                <ComboBoxItem Content="{DynamicResource Set.SectionFiles}" />
                <ComboBoxItem Content="{DynamicResource Set.SectionAppearance}" />
            </ComboBox>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <!-- Server -->
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionPicker}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                    <StackPanel IsEnabled="{Binding CanEditConnection}">
                        <TextBlock Text="{DynamicResource Set.Server}" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.Address}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.Port}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Port}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.SessionPassword}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox gui:Behaviors.BoundPassword="{Binding Password}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.LoopbackHint}" />
                    </StackPanel>
                </Border>

                <!-- Bot identity -->
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionPicker}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                    <StackPanel IsEnabled="{Binding CanEditConnection}">
                        <TextBlock Text="{DynamicResource Set.Identity}" Style="{StaticResource CardTitle}" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.AccountPrefix}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AccountPrefix}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.NamePrefix}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NamePrefix}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- New characters (newcharacter.ini) -->
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionPicker}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                    <StackPanel IsEnabled="{Binding CanEditConnection}">
                        <TextBlock Text="{DynamicResource Set.NewChars}" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{DynamicResource Set.Faction}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Faction}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Text="{DynamicResource Set.StartBase}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding BaseList}" Text="{Binding NewCharBase, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsTextSearchEnabled="True" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{DynamicResource Set.Package}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Package}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Text="{DynamicResource Set.Pilot}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Pilot}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Set.NewCharHint}" />
                    </StackPanel>
                </Border>

                <!-- Paths -->
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionPicker}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.Paths}" Style="{StaticResource CardTitle}" />
                        <StackPanel Style="{StaticResource Field}" IsEnabled="{Binding CanEditConnection}">
                            <TextBlock Text="{DynamicResource Set.DataDir}" Style="{StaticResource FieldLabel}" />
                            <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Common.Browse}" Click="BrowsePath" Tag="data" Margin="8,0,0,0" /><TextBox Text="{Binding DataDirectory}" /></DockPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.FlhookIni}" Style="{StaticResource FieldLabel}" />
                            <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Common.Browse}" Click="BrowsePath" Tag="ini" Margin="8,0,0,0" /><TextBox Text="{Binding FlhookIni}" /></DockPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.FlhookLog}" Style="{StaticResource FieldLabel}" />
                            <DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Common.Browse}" Click="BrowsePath" Tag="log" Margin="8,0,0,0" /><TextBox Text="{Binding ServerLogPath}" /></DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance and language -->
                <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionPicker}" Value="4"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Set.Appearance}" Style="{StaticResource CardTitle}" />
                        <CheckBox Content="{DynamicResource Set.DarkTheme}" IsChecked="{Binding IsDarkTheme}" Margin="0,0,0,14" />
                        <TextBlock Text="{DynamicResource Set.Language}" Style="{StaticResource FieldLabel}" />
                        <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="English" GroupName="Language"
                                             IsChecked="{Binding IsGerman, Converter={x:Static gui:InverseBool.Instance}}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Deutsch" GroupName="Language"
                                             IsChecked="{Binding IsGerman}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{DynamicResource Set.ThemeHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
