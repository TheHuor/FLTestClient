<UserControl x:Class="FLTestClient.Gui.Views.BehaviourView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="Field" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,12"/></Style></UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
   <TextBlock Text="{DynamicResource Nav.Behaviour}" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="{DynamicResource Behaviour.Scope}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,8,0,6"/>
   <TextBlock Text="{DynamicResource Behaviour.Timing}" Style="{StaticResource Muted}"/>
  </StackPanel>
  <TabControl Style="{StaticResource PageTabs}">
   <TabItem Header="{DynamicResource Behaviour.Movement}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch">                        <CheckBox Content="{DynamicResource Set.AutoLaunch}" IsChecked="{Binding AutoLaunch}" Margin="0,0,0,16" />

                        <CheckBox Content="{DynamicResource Set.CircleFlight}" IsChecked="{Binding CircleFlight}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12" IsEnabled="{Binding CircleFlight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.Radius}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CircleRadius}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.Speed}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CircleSpeed}" />
                            </StackPanel>
                        </Grid>

</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Behaviour.Sessions}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch">                        <CheckBox Content="{DynamicResource Set.SessionCycle}" IsChecked="{Binding SessionCycle}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12" IsEnabled="{Binding SessionCycle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Set.OnlineMin}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OnlineMinSeconds}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Set.OnlineMax}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OnlineMaxSeconds}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Set.Offline}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OfflineSeconds}" />
                            </StackPanel>
                        </Grid>

</StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Behaviour.Chat}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch">                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.ChatInterval}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ChatIntervalSeconds}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="{DynamicResource Set.ChatScript}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ChatScript}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
</StackPanel></ScrollViewer></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
