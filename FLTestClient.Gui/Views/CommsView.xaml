<UserControl x:Class="FLTestClient.Gui.Views.CommsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:FLTestClient.Gui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Comms.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Comms.Subtitle}" Style="{StaticResource Muted}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ListBox ItemsSource="{Binding Chat}" Style="{StaticResource FeedList}" ItemTemplate="{StaticResource FeedTemplate}"
                     gui:Behaviors.AutoScroll="True" />
        </Border>

        <!-- Input bar: quick commands, target and text -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Comms.Quick}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource ChipButton}" Content="/help" Command="{Binding QuickChatCommand}" CommandParameter="/help" />
                    <Button Style="{StaticResource ChipButton}" Content="/ping" Command="{Binding QuickChatCommand}" CommandParameter="/ping" />
                    <Button Style="{StaticResource ChipButton}" Content="/time" Command="{Binding QuickChatCommand}" CommandParameter="/time" />
                    <Button Style="{StaticResource ChipButton}" Content="/id" Command="{Binding QuickChatCommand}" CommandParameter="/id" />
                    <Button Style="{StaticResource ChipButton}" Content="/ids" Command="{Binding QuickChatCommand}" CommandParameter="/ids" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource Comms.Selected}" GroupName="ChatTarget"
                                         IsChecked="{Binding ChatToAll, Converter={x:Static gui:InverseBool.Instance}}" />
                            <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource Comms.AllBots}" GroupName="ChatTarget"
                                         IsChecked="{Binding ChatToAll}" />
                        </StackPanel>
                    </Border>
                    <TextBox Grid.Column="1" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding SendChatCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Comms.Send}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
