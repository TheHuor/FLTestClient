<UserControl x:Class="FLTestClient.Gui.Views.SelectionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}" Padding="12,8">
  <Expander Foreground="{DynamicResource TextPrimary}" Header="{Binding SelectionSummary}">
   <StackPanel Margin="0,8,0,0">
    <TextBlock Text="{Binding SelectionNames}" TextWrapping="Wrap" MaxHeight="90" />
    <Button Content="{DynamicResource Selection.Clear}" Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
   </StackPanel>
  </Expander>
 </Border>
</UserControl>
