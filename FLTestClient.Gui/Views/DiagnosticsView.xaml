<UserControl x:Class="FLTestClient.Gui.Views.DiagnosticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:gui="clr-namespace:FLTestClient.Gui" xmlns:views="clr-namespace:FLTestClient.Gui.Views">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <CheckBox DockPanel.Dock="Right" Content="{DynamicResource Log.AutoScroll}" IsChecked="{Binding AutoScrollLogs}" />
   <TextBlock Text="{DynamicResource Nav.Diagnostics}" Style="{StaticResource PageTitle}" />
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <RadioButton Style="{StaticResource SegmentButton}" GroupName="Diagnostics" Content="{DynamicResource Fleet.Activity}" IsChecked="True" x:Name="ActivityTab" />
   <RadioButton Style="{StaticResource SegmentButton}" GroupName="Diagnostics" Content="{DynamicResource Nav.ServerLog}" x:Name="ServerTab" />
  </WrapPanel>
  <Grid Grid.Row="2">
   <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ActivityTab}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="{DynamicResource Diagnostics.Hint}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
     <DataGrid DockPanel.Dock="Bottom" ItemsSource="{Binding Bots}" Height="130" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Name}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Pilot}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Unknown}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Unknown}"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
     <ListBox ItemsSource="{Binding Activity}" Style="{StaticResource FeedList}" ItemTemplate="{StaticResource FeedTemplate}" gui:Behaviors.AutoScroll="{Binding AutoScrollLogs}" />
    </DockPanel>
   </Border>
   <views:ServerLogView><views:ServerLogView.Style><Style TargetType="views:ServerLogView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ServerTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:ServerLogView.Style></views:ServerLogView>
  </Grid>
 </Grid>
</UserControl>
