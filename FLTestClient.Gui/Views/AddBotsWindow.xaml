<Window x:Class="FLTestClient.Gui.Views.AddBotsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Cards.AddBots}" Width="480" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="14">
 <DockPanel Margin="24">
  <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Cards.AddBots}" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{DynamicResource Common.Cancel}" IsCancel="True"/>
   <Button Content="{DynamicResource Fleet.StartBots}" Style="{StaticResource AccentButton}" Click="CreateBots" Margin="0"/>
  </StackPanel>
  <StackPanel>
   <TextBlock Text="{Binding ServerDisplay}" Foreground="{DynamicResource Accent}" Margin="0,0,0,16"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{DynamicResource Fleet.Count}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BotCount" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Fleet.From}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FirstIndex" Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   </Grid>
   <TextBlock Text="{DynamicResource Cards.AddHint}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
  </StackPanel>
 </DockPanel>
</Window>
