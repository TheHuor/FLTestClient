<UserControl x:Class="FLTestClient.Gui.Views.ServerLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:FLTestClient.Gui">
    <UserControl.Resources>
        <Style x:Key="CounterCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Log.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Log.Subtitle}" Style="{StaticResource Muted}" />
            <TextBlock Text="{Binding LogMonitoringSummary}" Foreground="{DynamicResource Accent}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- File and switches -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ServerLogPath}" ToolTip="{DynamicResource Log.PathTip}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                    <CheckBox Content="{DynamicResource Log.Follow}" IsChecked="{Binding FollowServerLog}" Margin="0,0,16,0" />
                    <CheckBox Content="{DynamicResource Log.ImportantOnly}" IsChecked="{Binding ImportantOnly}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Counters -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource CounterCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TimeLagCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Warning}" FontSize="26" />
                    <TextBlock Text="{DynamicResource Log.TimeLags}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCard}">
                <StackPanel>
                    <TextBlock Text="{Binding KickCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}" FontSize="26" />
                    <TextBlock Text="{DynamicResource Log.Kicks}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCard}">
                <StackPanel>
                    <TextBlock Text="{Binding CheatCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Special}" FontSize="26" />
                    <TextBlock Text="{DynamicResource Log.Cheats}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CounterCard}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Danger}" FontSize="26" />
                    <TextBlock Text="{DynamicResource Log.Errors}" Style="{StaticResource StatLabel}" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource ChipButton}" Content="{DynamicResource Log.ResetCounters}" Command="{Binding ResetCountersCommand}"
                    VerticalAlignment="Center" />
        </WrapPanel>

        <!-- Live feed -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <ListBox ItemsSource="{Binding ServerLog}" Style="{StaticResource FeedList}" gui:Behaviors.AutoScroll="{Binding AutoScrollLogs}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Style="{StaticResource ToneText}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
