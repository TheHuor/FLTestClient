<UserControl x:Class="FLTestClient.Gui.Views.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="clr-namespace:FLTestClient.Gui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="8" />
            <RowDefinition Height="210" MinHeight="90" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Fleet.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource Fleet.Subtitle}" Style="{StaticResource Muted}" />
        </StackPanel>

        <!-- Action bar: row 1 creates bots, row 2 acts on the selected bots -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Fleet.NewBots}" Style="{StaticResource CardTitle}" Width="120" Margin="0,0,0,8"
                               VerticalAlignment="Bottom" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Fleet.Count}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Count}" Width="56" HorizontalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Fleet.From}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StartIndex}" Width="56" HorizontalContentAlignment="Center" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Fleet.AutoStart}" IsChecked="{Binding AutoLaunch}" IsEnabled="{Binding CanEditConnection}"
                                  VerticalAlignment="Bottom" Margin="0,0,14,8" ToolTip="{DynamicResource Fleet.AutoStartTip}" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartBotsCommand}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Fleet.StartBots}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" Command="{Binding DisconnectAllCommand}"
                            VerticalAlignment="Bottom" Margin="0" ToolTip="{DynamicResource Fleet.LogoutAllTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Fleet.LogoutAll}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource PanelBorder}" Margin="0,12,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Fleet.Selection}" Style="{StaticResource CardTitle}" Width="120" Margin="0,0,0,8"
                               VerticalAlignment="Bottom" />
                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding LaunchSelectedCommand}" VerticalAlignment="Bottom" ToolTip="{DynamicResource Fleet.LaunchTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE709;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Fleet.Launch}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Fleet.DockTarget}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding BaseList}" Text="{Binding DockTarget, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" IsTextSearchEnabled="True" Width="190" />
                        </StackPanel>
                        <Button Command="{Binding DockSelectedCommand}" VerticalAlignment="Bottom" ToolTip="{DynamicResource Fleet.DockTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Fleet.Dock}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DistributeSelectedCommand}" VerticalAlignment="Bottom" ToolTip="{DynamicResource Fleet.DistributeTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Fleet.Distribute}" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Background="{DynamicResource PanelBorder}" Margin="6,2,14,2" />
                        <Button Command="{Binding ReconnectSelectedCommand}" VerticalAlignment="Bottom" ToolTip="{DynamicResource Fleet.ReconnectTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Fleet.Reconnect}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveSelectedCommand}" VerticalAlignment="Bottom" ToolTip="{DynamicResource Fleet.DisconnectTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Fleet.Disconnect}" />
                            </StackPanel>
                        </Button>
                        <Button Content="{DynamicResource Fleet.SelectAll}" Command="{Binding SelectAllCommand}" VerticalAlignment="Bottom" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Fleet list. Column headers are TextBlocks because DynamicResource does not resolve on DataGridColumn. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <DataGrid ItemsSource="{Binding Bots}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Index}" Width="50">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Nr}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" FontWeight="SemiBold">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Pilot}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="1.2*">
                            <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Col.Status}" /></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StateBadge}">
                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StateBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding System}" Width="*">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.System}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Base}" Width="1.3*">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Base}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Ship}" Width="70">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Ship}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Cash}" Width="100">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Credits}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Ping}" Width="70">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Ping}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Unknown}" Width="60">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Unknown}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bots.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="{StaticResource LogoMark}" Width="96" Height="96" HorizontalAlignment="Center" Opacity="0.85" />
                    <TextBlock Text="{DynamicResource Fleet.EmptyTitle}" Style="{StaticResource PageTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="{DynamicResource Fleet.EmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />

        <!-- Activity -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource Fleet.Activity}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="{DynamicResource Fleet.SelectedOnly}" IsChecked="{Binding ActivitySelectedOnly}" Margin="0,0,12,0" />
                        <Button Style="{StaticResource ChipButton}" Content="{DynamicResource Common.Clear}" Command="{Binding ClearActivityCommand}" Margin="0" />
                    </StackPanel>
                </DockPanel>
                <ListBox ItemsSource="{Binding Activity}" Style="{StaticResource FeedList}" ItemTemplate="{StaticResource FeedTemplate}"
                         gui:Behaviors.AutoScroll="True" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
