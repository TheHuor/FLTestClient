<UserControl x:Class="FLTestClient.Gui.Views.FleetView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:gui="clr-namespace:FLTestClient.Gui" xmlns:views="clr-namespace:FLTestClient.Gui.Views">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="{DynamicResource Cards.AddBots}" Style="{StaticResource AccentButton}" Command="{Binding ShowAddBotsCommand}" />
    <Button Content="{DynamicResource Fleet.LogoutAll}" Command="{Binding DisconnectAllCommand}" />
   </StackPanel>
   <TextBlock Text="{DynamicResource Fleet.Title}" Style="{StaticResource PageTitle}" />
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBox Text="{Binding FleetSearch, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="{DynamicResource Fleet.Search}" AutomationProperties.Name="{DynamicResource Fleet.Search}" Margin="0,0,10,6">
    <TextBox.Resources><VisualBrush x:Key="SearchHint" AlignmentX="Left" AlignmentY="Center" Stretch="None"><VisualBrush.Visual><TextBlock Text="{DynamicResource Cards.Search}" Foreground="{DynamicResource TextMuted}" Margin="9,0"/></VisualBrush.Visual></VisualBrush></TextBox.Resources>
    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Background" Value="{StaticResource SearchHint}"/></Trigger></Style.Triggers></Style></TextBox.Style>
   </TextBox>
   <ComboBox SelectedIndex="{Binding FleetStateFilter}" Width="150" Margin="0,0,10,6" AutomationProperties.Name="{DynamicResource Col.Status}">
    <ComboBoxItem Content="{DynamicResource Filter.All}"/><ComboBoxItem Content="{DynamicResource Stat.InSpace}"/><ComboBoxItem Content="{DynamicResource Stat.Docked}"/><ComboBoxItem Content="{DynamicResource Stat.Errors}"/>
   </ComboBox>
   <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource Cards.View}" IsChecked="{Binding UseCardView}" Margin="0,0,0,6"/>
   <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource Cards.Table}" IsChecked="{Binding UseCardView, Converter={x:Static gui:InverseBool.Instance}}" Margin="0,0,10,6"/>
   <Button Content="{DynamicResource Fleet.SelectAll}" Command="{Binding SelectVisibleCommand}" Margin="0,0,10,6"/>
   <CheckBox Content="{DynamicResource Inspector.Title}" IsChecked="{Binding IsInspectorOpen}" VerticalAlignment="Center" Margin="0,0,0,6"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid>
    <ScrollViewer x:Name="CardsHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding UseCardView}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
     <ItemsControl x:Name="CardsItems" ItemsSource="{Binding FleetRows}" SizeChanged="CardsSizeChanged" Loaded="CardsLoaded">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Margin="0,0,10,10" Padding="12,10" Height="110" CornerRadius="8" BorderThickness="1" Background="{DynamicResource PanelBackground}"
         MouseLeftButtonDown="CardClicked" KeyDown="CardKeyDown" Focusable="True" ContextMenuOpening="CardMenuOpening" AutomationProperties.Name="{Binding Name}">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/><Style.Triggers>
         <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
        </Style.Triggers></Style></Border.Style>
        <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="…" Width="28" Padding="0" Margin="4,0,0,0" Click="OpenCardMenu" ToolTip="{DynamicResource Cards.Menu}" AutomationProperties.Name="{DynamicResource Cards.Menu}"/>
          <CheckBox Style="{StaticResource BotSelectionBox}" DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" PreviewMouseLeftButtonDown="ToggleCardSelection" Checked="CardCheckChanged" Unchecked="CardCheckChanged" AutomationProperties.Name="{Binding Name}"/>
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
         </DockPanel>
         <DockPanel Grid.Row="1" Margin="0,7,0,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Ping}" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
          <Border Style="{StaticResource StateBadge}" MaxWidth="230"><TextBlock Text="{Binding StateLabel}" Style="{StaticResource StateBadgeText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateLabel}"/></Border>
         </DockPanel>
         <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis">
          <Run Text="{Binding System, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Base, Mode=OneWay}"/>
         </TextBlock>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
<DataGrid x:Name="FleetTable" ItemsSource="{Binding FleetRows}" SelectionChanged="TableSelectionChanged" PreviewMouseLeftButtonDown="TableLeftClick" PreviewMouseRightButtonDown="TableRightClick" ContextMenuOpening="TableMenuOpening">
                    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
                    <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseCardView}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Index}" Width="50">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Nr}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" FontWeight="SemiBold">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Pilot}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="1.2*">
                            <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Col.Status}" /></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StateBadge}">
                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource StateBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding System}" Width="*">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.System}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Base}" Width="1.3*">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Base}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Ship}" Width="70">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Ship}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Cash}" Width="100">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Credits}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Ping}" Width="70">
                            <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Col.Ping}" /></DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="20">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Bots.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Image Source="{StaticResource LogoMark}" Width="72" Height="72" HorizontalAlignment="Center"/>
     <TextBlock Text="{DynamicResource Fleet.EmptyTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8" HorizontalAlignment="Center"/>
     <TextBlock Text="{DynamicResource Fleet.EmptyText}" Style="{StaticResource Muted}" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <views:BotInspector Grid.Column="1" Width="310" Margin="12,0,0,0">
    <views:BotInspector.Style><Style TargetType="views:BotInspector"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowInspector}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:BotInspector.Style>
   </views:BotInspector>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,10,0,0">
   <DockPanel Margin="0,0,0,8">
    <Button DockPanel.Dock="Right" Content="{DynamicResource Cards.BulkActions}" Click="OpenBulkMenu" Margin="8,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="{DynamicResource Selection.Clear}" Command="{Binding ClearSelectionCommand}" Margin="8,0,0,0"/>
    <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Expander Header="{DynamicResource Fleet.Activity}" Foreground="{DynamicResource TextPrimary}">
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Top" Content="{DynamicResource Common.Clear}" Command="{Binding ClearActivityCommand}" HorizontalAlignment="Right"/>
     <ListBox Height="130" ItemsSource="{Binding Activity}" Style="{StaticResource FeedList}" ItemTemplate="{StaticResource FeedTemplate}" gui:Behaviors.AutoScroll="{Binding AutoScrollLogs}"/>
    </DockPanel>
   </Expander>
  </StackPanel>
 </Grid>
</UserControl>
