<Application x:Class="FLTestClient.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 0: colour palette, swapped by App.ApplyTheme. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <!-- 1: English texts, always present as fallback. -->
                <ResourceDictionary Source="Languages/en.xaml" />
                <!-- 2: active language, swapped by App.ApplyLanguage (later dictionaries win). -->
                <ResourceDictionary Source="Languages/en.xaml" />
                <!-- 3: styles; they only use DynamicResource colours. -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <!-- 4: logo (fixed colours, also the source of the app icon). -->
                <ResourceDictionary Source="Assets/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colour of a feed line by FeedEntry.Tone. -->
            <Style x:Key="ToneText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Muted"><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Special"><Setter Property="Foreground" Value="{DynamicResource Special}" /></DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- State badge of a bot row by BotRowViewModel.StateTone. -->
            <Style x:Key="StateBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateTone}" Value="Accent"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Success"><Setter Property="BorderBrush" Value="{DynamicResource Success}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource Warning}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Danger"><Setter Property="BorderBrush" Value="{DynamicResource Danger}" /></DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StateBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateTone}" Value="Accent"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StateTone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Template for feed lines: time, source, text. -->
            <DataTemplate x:Key="FeedTemplate">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" MinWidth="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource ToneText}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
