<Window x:Class="FLTestClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FLTestClient.Gui.Views"
        Title="FLTestClient · Fleet Control" Icon="Assets/FLTestClient.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Quiet global context; fleet cards carry the detailed state. -->
        <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="{StaticResource LogoMark}" Width="34" Height="34" Margin="0,0,10,0"/>
                    <TextBlock Text="FLTESTCLIENT" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageCode}" ToolTip="{DynamicResource Header.LanguageTip}"/>
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="{DynamicResource Header.ThemeTip}" Margin="0"><TextBlock Text="{Binding ThemeIcon}" Style="{StaticResource Icon}"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Header.GameServer}" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ServerDisplay}" Margin="0,0,18,0"/>
                    <TextBlock Foreground="{DynamicResource TextMuted}"><Run Text="{Binding Bots.Count, Mode=OneWay}"/><Run Text=" "/><Run Text="{DynamicResource Header.Managed}"/></TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation and pages -->
        <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}" SelectedIndex="{Binding MainPageIndex}">
            <TabItem Header="{DynamicResource Nav.Fleet}" Tag="&#xE716;">
                <views:FleetView />
            </TabItem>
            <TabItem Header="{DynamicResource Nav.Behaviour}" Tag="&#xE713;"><views:BehaviourView /></TabItem>
            <TabItem Header="{DynamicResource Nav.Comms}" Tag="&#xE8BD;">
                <views:CommsView />
            </TabItem>
            <TabItem Header="{DynamicResource Nav.Command}" Tag="&#xE756;">
                <views:CommandView />
            </TabItem>
            <TabItem Header="{DynamicResource Nav.Diagnostics}" Tag="&#xE9D9;">
                <views:DiagnosticsView />
            </TabItem>
            <TabItem Header="{DynamicResource Nav.Settings}" Tag="&#xE713;">
                <views:SettingsView />
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
                Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion, Mode=OneTime}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="16,0,0,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
